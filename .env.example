# Gmail credentials for lawn watering advisor
# Copy this file to .env and fill in your values — NEVER commit .env to git

# The Gmail address that sends the alert emails
GMAIL_USER=your.gmail.address@gmail.com

# A Gmail App Password (NOT your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# Format: 16-character string, typically shown as "xxxx xxxx xxxx xxxx"
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
